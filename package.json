    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "sass": "^1.104.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.3.1"
  }
}
